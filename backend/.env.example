SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Fonepay configuration
FONEPAY_MERCHANT_ID=YOUR_FONEPAY_MERCHANT_ID
FONEPAY_MERCHANT_SECRET=YOUR_FONEPAY_MERCHANT_SECRET
FONEPAY_FORM_URL=https://sandbox.fonepay.com.np/api/payment
FONEPAY_VERIFY_URL=https://sandbox.fonepay.com.np/api/verify
MINIMUM_INITIAL_PAYMENT=300
# Use the deployed public origin in production; this local value supports checkout testing.
STORE_PUBLIC_URL=http://127.0.0.1:8001

# Optional Meta WhatsApp Cloud API order notifications.
# Create an approved WhatsApp Business Platform setup and keep the token secret.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=+9779851144738
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0

# OSM-compatible services. Public defaults suit low-volume development;
# production stores should use hosted/self-hosted services with an SLA.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_ROUTING_URL=https://router.project-osrm.org
OSM_ROUTING_FALLBACK_URL=
# STORE_CONTACT_EMAIL is used in geocoding requests; public contact details are separate.
STORE_CONTACT_EMAIL=
STORE_PUBLIC_EMAIL=
STORE_CONTACT_PHONE=+977 985-1144738
SEO_SITE_URL=https://online-liquor-land.onrender.com
STORE_ORIGIN_LATITUDE=
STORE_ORIGIN_LONGITUDE=
