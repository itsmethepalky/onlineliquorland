SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Fonepay Dynamic QR configuration. Keep all credentials server-side.
FONEPAY_MERCHANT_CODE=YOUR_FONEPAY_MERCHANT_CODE
FONEPAY_MERCHANT_SECRET=YOUR_FONEPAY_SHARED_SECRET
FONEPAY_USERNAME=YOUR_FONEPAY_API_USERNAME
FONEPAY_PASSWORD=YOUR_FONEPAY_API_PASSWORD
FONEPAY_API_BASE_URL=https://dev-merchantapi.fonepay.com/convergentmerchantweb/api
FONEPAY_QR_GENERATE_PATH=/merchant/merchantDetailsForThirdParty/thirdPartyDynamicQrDownload
FONEPAY_QR_VERIFY_PATH=/merchant/merchantDetailsForThirdParty/txnVerification
# Legacy hosted-callback settings retained only for already-started redirects.
FONEPAY_MERCHANT_ID=
FONEPAY_VERIFY_URL=https://sandbox.fonepay.com.np/api/verify
MINIMUM_INITIAL_PAYMENT=300
# Use the deployed public origin in production; this local value supports checkout testing.
STORE_PUBLIC_URL=http://127.0.0.1:8001

# Optional Meta WhatsApp Cloud API order notifications.
# Create an approved WhatsApp Business Platform setup and keep the token secret.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1425584130638254
WHATSAPP_BUSINESS_ACCOUNT_ID=1750233889418582
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=33ddd8c6dd57d11c15a5bf375add6acf
WHATSAPP_ADMIN_PHONE=+9779851144738
WHATSAPP_TEMPLATE_NAME=admin_new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0

# OSM-compatible services. Public defaults suit low-volume development;
# production stores should use hosted/self-hosted services with an SLA.
